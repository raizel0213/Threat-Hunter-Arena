# Copy this to .env and edit before running

# Comma-separated allowed CORS origins. Use * only for local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite DB path. For Docker this is handled via volume mount.
# DATABASE_URL=sqlite:////app/app/data/arena.db

# Rate limits (requests per time window per IP)
RATE_LIMIT_SUBMIT=10/minute
RATE_LIMIT_DEFAULT=60/minute

# YARA rule execution timeout in seconds
YARA_TIMEOUT_SECONDS=5

# Max rule size in bytes (32 KB default)
MAX_RULE_BYTES=32768

# Max player name length
MAX_PLAYER_NAME_LEN=32

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
